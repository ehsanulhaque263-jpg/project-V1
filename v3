#include <stdio.h>
#include <math.h>
void banner(void);
void menu(void);
void record(void);
int get_id(int id);
int number_plate(int number);
char violation_type(char vio);
double fine(double f);
double net_fine(double f, int oc_number);

int main(void)
{
    int id;
    int number;
    char vio;
    double f;
    int oc_number;
    double total_fine;
    printf("Enter ID: ");
    scanf("%d", &id);
    printf("Enter number: ");
    scanf("%d", &number);
    printf("Enter violation type: ");
    scanf(" %c", &vio);
    printf("Enter fine: ");
    scanf("%lf", &f);
    printf("Enter occurrence number: ");
    scanf("%d", &oc_number);
    banner();
    menu();
    record();
    get_id(id);
    number_plate(number);
    violation_type(vio);
    fine(f);
    total_fine = net_fine(f, oc_number);
    printf("Total fine   \t:%8.2f\n", total_fine);

    return 0;
}
